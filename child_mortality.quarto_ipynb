  "cells": [
    {
      "cell_type": "markdown",
      "metadata": {},
      "source": [
        "---\n",
        "title: \"Child Mortality Rates - Under 5 Population\"\n",
        "author: \"George Davis\"\n",
        "format: \n",
        "    dashboard:\n",
        "        theme: lumen\n",
        "        embed-resources: true\n",
        "        scrolling: false\n",
        "---\n"
      ],
      "id": "da20d869"
    },
    {
      "cell_type": "code",
      "metadata": {},
      "source": [
        "import pandas as pd\n",
        "import plotly.express as px\n",
        "from itables import show \n",
        "\n",
        "# Load raw data from specified paths: child mortality\n",
        "\n",
        "child_mort_raw = pd.read_csv(\"data/child_mortality_0_5_year_olds_dying_per_1000_born.csv\")\n",
        "\n",
        "# Applying 'drop' to remove the *geo* column and keeping the dataframe.\n",
        "# child_mort_raw = child_mort_raw.drop(columns=[\"geo\"])#\n",
        "\n",
        "# Load raw data from specified paths: under five population\n",
        "\n",
        "under_five_pop_raw = pd.read_csv(\"data/u5pop.csv\")\n",
        "\n",
        "# Applying 'drop' to remove the *geo* column and keeping the dataframe.\n",
        "# under_five_pop_raw = under_five_pop_raw.drop(columns=[\"geo\"])\n",
        "\n",
        "#Keeping the renaming changes in the dataframe\n",
        "\n",
        "child_mort_raw = child_mort_raw.rename(columns={\"name\": \"country\"})\n",
        "\n",
        "# Keeping the renaming changes in the dataframe.\n",
        "under_five_pop_raw = under_five_pop_raw.rename(columns={\"name\": \"country\"})\n",
        "\n",
        "# Melt from wide to long format and adding a new dataframe 'child_mort_long'\n",
        "\n",
        "child_mort_long = child_mort_raw.melt(\n",
        "    id_vars=[\"geo\", \"country\"],\n",
        "    var_name=\"year\",\n",
        "    value_name=\"deaths\"\n",
        ").sort_values(by=[\"country\", \"year\"])\n",
        "\n",
        "# Melt from wide to long format and adding a new dataframe 'under_five_pop_long'\n",
        "\n",
        "under_five_pop_long = under_five_pop_raw.melt(\n",
        "    id_vars=[\"geo\", \"country\"],\n",
        "    var_name=\"year\",\n",
        "    value_name=\"population\"\n",
        ").sort_values(by=[\"country\", \"year\"])\n",
        "\n",
        "# Joining the two datasets using 'merge' into a new dataframe 'child_mort_pop_combined'\n",
        "\n",
        "# Adding a new dataframe 'child_mort_pop_combined'\n",
        "\n",
        "child_mort_pop_combined = pd.merge(child_mort_long, under_five_pop_long, on=[\"country\", \"year\"], how=\"outer\")\n",
        "\n",
        "# Convert year to numeric using pd.to_numeric\n",
        "\n",
        "child_mort_pop_combined[\"year\"] = pd.to_numeric(child_mort_pop_combined[\"year\"], errors=\"coerce\")\n",
        "\n",
        "# Creating a new dataframe with the range in years 2010 - 2020.\n",
        "\n",
        "# Querying for the years\n",
        "child_mort_pop_combined_2010_2020 = child_mort_pop_combined[child_mort_pop_combined[\"year\"].between(2010, 2020)]\n",
        "\n",
        "# Querying my selected a few countries in a new dataframe also displaying the range in years from 2010 to 2020.\n",
        "\n",
        "child_mort_pop_combined_subset = child_mort_pop_combined_2010_2020.query(\"country.isin(['Nigeria', 'Congo, Dem.Rep.', 'Pakistan', 'India', 'Bangladesh', 'Indonesia', 'Brazil', 'China', 'USA', 'Russia', 'Egypt', 'Philippines', 'Mexico'])\")\n",
        "\n",
        "# Creating a line chart. \n",
        "\n",
        "fig_chart = px.line(\n",
        "    child_mort_pop_combined_subset,\n",
        "    x=\"year\",\n",
        "    y=\"deaths\",\n",
        "    markers=True,\n",
        "    color=\"country\"\n",
        ").update_layout(showlegend=False)\n",
        "\n",
        "\n",
        "\n",
        "\n",
        "# Table section\n",
        "\n",
        "# Subset the data to include `country`, `2010`, and `2020` columns only.\n",
        "table_df = child_mort_raw[[\"country\", \"2010\", \"2020\"]]\n",
        "\n",
        "# Calculate difference of mortality rate between 2010 and 2020\n",
        "\n",
        "table_df[\"Absolute Change\"] = table_df[\"2010\"] - table_df[\"2020\"]\n",
        "\n",
        "# Calculate relative change as the absolute change in mortality divided by 2010 rates.\n",
        "\n",
        "\n",
        "#old code - table_df[\"Relative Change\"] = table_df[\"2010\"] / table_df[\"2020\"] * 100\n",
        "# this code calculates the ration instead of relative  change.\n",
        "\n",
        "# Corrected code explained from Google Gemini.\n",
        "\n",
        "# Correct formula: (New - Old) / Old * 100\n",
        "\n",
        "# Explanation - To find the relative change (how much the value changed from 2010 to 2020 relative to the starting year 2010), you need to subtract the old value from the new value, and then divide by the old value.\n",
        "\n",
        "table_df[\"Relative Change\"] = (table_df[\"2020\"] - table_df[\"2010\"]) / table_df[\"2010\"] * 100\n",
        "\n",
        "\n",
        "# Round to 0 decimal places and adding a % sign to the the relative change.\n",
        "\n",
        "table_df[\"Relative Change\"] = table_df[\"Relative Change\"].round(0).astype(str) + \"%\"\n",
        "\n",
        "\n",
        "child_mort_pop_combined_2010_2020 = child_mort_pop_combined_2010_2020.query(\"year == 2010\")\n",
        "\n",
        "# Compute highest child mortality rates\n",
        "highest_row = child_mort_pop_combined_2010_2020.sort_values(\"deaths\", ascending=False).head(1).squeeze()\n",
        "highest_child_mortality_country = highest_row[\"country\"]\n",
        "highest_child_mortality_value = round(highest_row[\"deaths\"], 1)\n",
        "\n",
        "# Compute lowest child mortality rates\n",
        "lowest_row = child_mort_pop_combined_2010_2020.sort_values(\"deaths\", ascending=True).head(1).squeeze()\n",
        "lowest_child_mortality_country = lowest_row[\"country\"]\n",
        "lowest_child_mortality_value = round(lowest_row[\"deaths\"], 1)\n",
        "\n",
        "# Compute average (population-weighted) child mortality\n",
        "weighted_mean = (child_mort_pop_combined_2010_2020[\"deaths\"] * child_mort_pop_combined_2010_2020[\"population\"]).sum() / child_mort_pop_combined_2010_2020[\"population\"].sum()\n",
        "average_child_mortality_value = round(weighted_mean, 1)\n",
        "\n",
        "\n",
        "# Largest 8 countries with child mortality rates (bar chart) with a blue color scale\n",
        "\n",
        "top_8 = child_mort_pop_combined_2010_2020.nlargest(8, \"population\").sort_values(\"deaths\", ascending=True)\n",
        "bar_fig = px.bar(\n",
        "    top_8,\n",
        "    x=\"deaths\",\n",
        "    y=\"country\",\n",
        "    title=\"Child Mortality Rates in 8 Largest Countries\",\n",
        "    color=\"deaths\",\n",
        "    color_continuous_scale=\"Greens\",\n",
        ").update_layout(coloraxis_showscale=False)\n",
        "\n",
        "\n",
        "# Create the map using plotly express. Convert the existing ISO3 codes to uppercase.\n",
        "\n",
        "# I do not see the conversions.\n",
        "\n",
        "child_mort_pop_combined_subset[\"geo_x\"] = child_mort_pop_combined_subset[\"geo_y\"].str.upper()\n",
        "\n",
        "map_fig = px.choropleth(\n",
        "    child_mort_pop_combined_subset,\n",
        "    locations=\"geo_x\",\n",
        "    color=\"country\",\n",
        "    hover_name=\"deaths\",\n",
        "    title=\"Child Mortality Rates (2010-2020) for Selected Countries\",\n",
        ").update_layout(showlegend=False)"
      ],
      "id": "b0e6e5f4",
      "execution_count": null,
      "outputs": []
    },
    {
      "cell_type": "markdown",
      "metadata": {},
      "source": [
