      "source": [
        "child_mort_pop_combined_2010_2020 = child_mort_pop_combined_2010_2020.query(\"year == 2010\")\n",
        "\n",
        "# Compute highest child mortality rates\n",
        "highest_row = child_mort_pop_combined_2010_2020.sort_values(\"deaths\", ascending=False).head(1).squeeze()\n",
        "highest_child_mortality_country = highest_row[\"country\"]\n",
        "highest_child_mortality_value = round(highest_row[\"deaths\"], 1)\n",
        "\n",
        "# Compute lowest child mortality rates\n",
        "lowest_row = child_mort_pop_combined_2010_2020.sort_values(\"deaths\", ascending=True).head(1).squeeze()\n",
        "lowest_child_mortality_country = lowest_row[\"country\"]\n",
        "lowest_child_mortality_value = round(lowest_row[\"deaths\"], 1)\n",
        "\n",
        "# Compute average (population-weighted) child mortality\n",
        "weighted_mean = (child_mort_pop_combined_2010_2020[\"deaths\"] * child_mort_pop_combined_2010_2020[\"population\"]).sum() / child_mort_pop_combined_2010_2020[\"population\"].sum()\n",
        "average_child_mortality_value = round(weighted_mean, 1)"
