      "source": [
        "import pandas as pd\n",
        "import plotly.express as px\n",
        "from itables import show \n",
        "\n",
        "# Load raw data from specified paths: child mortality\n",
        "\n",
        "child_mort_raw = pd.read_csv(\"data/child_mortality_0_5_year_olds_dying_per_1000_born.csv\")\n",
        "\n",
        "# Applying 'drop' to remove the *geo* column and keeping the dataframe.\n",
        "# child_mort_raw = child_mort_raw.drop(columns=[\"geo\"])#\n",
        "\n",
        "# Load raw data from specified paths: under five population\n",
        "\n",
        "under_five_pop_raw = pd.read_csv(\"data/u5pop.csv\")\n",
        "\n",
        "# Applying 'drop' to remove the *geo* column and keeping the dataframe.\n",
        "# under_five_pop_raw = under_five_pop_raw.drop(columns=[\"geo\"])\n",
        "\n",
        "#Keeping the renaming changes in the dataframe\n",
        "\n",
        "child_mort_raw = child_mort_raw.rename(columns={\"name\": \"country\"})\n",
        "\n",
        "# Keeping the renaming changes in the dataframe.\n",
        "under_five_pop_raw = under_five_pop_raw.rename(columns={\"name\": \"country\"})\n",
        "\n",
        "# Melt from wide to long format and adding a new dataframe 'child_mort_long'\n",
        "\n",
        "child_mort_long = child_mort_raw.melt(\n",
        "    id_vars=[\"geo\", \"country\"],\n",
        "    var_name=\"year\",\n",
        "    value_name=\"deaths\"\n",
        ").sort_values(by=[\"country\", \"year\"])\n",
        "\n",
        "# Melt from wide to long format and adding a new dataframe 'under_five_pop_long'\n",
        "\n",
        "under_five_pop_long = under_five_pop_raw.melt(\n",
        "    id_vars=[\"geo\", \"country\"],\n",
        "    var_name=\"year\",\n",
        "    value_name=\"population\"\n",
        ").sort_values(by=[\"country\", \"year\"])\n",
        "\n",
        "# Joining the two datasets using 'merge' into a new dataframe 'child_mort_pop_combined'\n",
        "\n",
        "# Adding a new dataframe 'child_mort_pop_combined'\n",
        "\n",
        "child_mort_pop_combined = pd.merge(child_mort_long, under_five_pop_long, on=[\"country\", \"year\"], how=\"outer\")\n",
        "\n",
        "# Convert year to numeric using pd.to_numeric\n",
        "\n",
        "child_mort_pop_combined[\"year\"] = pd.to_numeric(child_mort_pop_combined[\"year\"], errors=\"coerce\")\n",
        "\n",
        "# Creating a new dataframe with the range in years 2010 - 2020.\n",
        "\n",
        "# Querying for the years\n",
        "child_mort_pop_combined_2010_2020 = child_mort_pop_combined[child_mort_pop_combined[\"year\"].between(2010, 2020)]\n",
        "\n",
        "# Querying my selected 5 countries in a new dataframe also displaying the range in years from 1990 to 2020.\n",
        "\n",
        "child_mort_pop_combined_subset = child_mort_pop_combined_2010_2020.query(\"country.isin(['Afghanistan', 'Australia', 'Ghana', 'Albania', 'Chile'])\")\n",
        "\n",
        "# Creating a line chart. \n",
        "\n",
        "fig_chart = px.line(\n",
        "    child_mort_pop_combined_subset,\n",
        "    x=\"year\",\n",
        "    y=\"deaths\",\n",
        "    markers=True,\n",
        "    color=\"country\"\n",
        ")\n",
        "\n",
        "# Table section\n",
        "\n",
        "# Subset the data to include `country`, `2010`, and `2020` columns only.\n",
        "table_df = child_mort_raw[[\"country\", \"2010\", \"2020\"]]\n",
        "\n",
        "# Calculate difference of mortality rate between 2010 and 2020\n",
        "\n",
        "table_df[\"Absolute Change\"] = table_df[\"2010\"] - table_df[\"2020\"]\n",
        "\n",
        "# Calculate relative change as the absolute change in mortality divided by 2010 rates.\n",
        "\n",
        "table_df[\"Relative Change\"] = table_df[\"2010\"] / table_df[\"2020\"] * 100\n",
        "\n",
        "# Round to 0 decimal places and adding a % sign to the the relative change.\n",
        "\n",
        "table_df[\"Relative Change\"] = table_df[\"Relative Change\"].round(0).astype(str) + \"%\"\n"
      ],
